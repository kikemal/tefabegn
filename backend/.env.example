# Server
NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://tefabign:tefabign@127.0.0.1:5433/tefabign?schema=public

# Auth — use a long random secret in real environments (never commit real secrets)
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=8h
REFRESH_TOKEN_DAYS=30

# Security (TASK-016)
# Comma-separated browser origins. Required in production. Empty allows all only in non-production.
CORS_ORIGINS=http://localhost:5173
# Set to false to disable in-memory rate limiting (not recommended outside local debugging)
RATE_LIMIT_ENABLED=true
